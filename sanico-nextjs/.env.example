# ── SaniCo Environment Variables ──
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# Your payment processor checkout URL
NEXT_PUBLIC_CHECKOUT_URL=https://your-checkout-link.com/sanico-guide

# Your production domain (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://sanicogroup.com
